# =============================================================
# DATABASE
# =============================================================
DATABASE_URL="postgresql://agrofinance:password@localhost:5432/agrofinance_dev"

# =============================================================
# AUTH
# Gerar com: openssl rand -base64 64
# =============================================================
JWT_SECRET="change-me-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="change-me-with-another-32-random-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================================
# API
# =============================================================
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# =============================================================
# EXTERNAL JOBS
# Mesmo valor no Render e em GitHub Actions > Secrets.
# =============================================================
CRON_SECRET="change-me-with-a-random-secret"

# =============================================================
# AWS S3 (ou MinIO em dev)
# =============================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="agrofinance-files"
# Descomente para usar MinIO localmente
# AWS_ENDPOINT_URL="http://localhost:9000"

# =============================================================
# REDIS (para queues — necessário na V2 com OCR)
# =============================================================
REDIS_URL="redis://localhost:6379"

# =============================================================
# ASSISTENTE + WHATSAPP PESSOAL (opcional; somente no backend)
# Guia completo: docs/whatsapp.md
# =============================================================
AI_ENABLED="false"
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
WHATSAPP_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Descomente e preencha a versão exibida no painel da Meta (ex.: v25.0).
# WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_ALLOWED_PHONE=""
WHATSAPP_USER_EMAIL=""
# Se houver mais de uma empresa ativa, informe seu UUID.
# WHATSAPP_COMPANY_ID=""
WHATSAPP_MEDIA_MODEL="gemini-2.5-flash"

# =============================================================
# WEB (Next.js)
# =============================================================
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# =============================================================
# POSTGRES (para docker-compose)
# =============================================================
POSTGRES_USER="agrofinance"
POSTGRES_PASSWORD="password"
POSTGRES_DB="agrofinance_dev"
